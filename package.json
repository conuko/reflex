{
  "name": "reflex",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "oxfmt --check && oxlint --deny-warnings && pnpm typecheck && pnpm check:terms",
    "check:terms": "tsx --env-file-if-exists=.env scripts/check-terms.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:reset": "prisma migrate reset",
    "worker": "tsx watch --env-file-if-exists=.env src/worker/index.ts",
    "worker:start": "tsx --env-file-if-exists=.env src/worker/index.ts",
    "eval:split": "tsx --env-file-if-exists=.env eval/build-split.ts",
    "eval:run": "tsx --env-file-if-exists=.env eval/run-eval.ts",
    "eval:candidates": "tsx --env-file-if-exists=.env eval/snapshot-candidates.ts",
    "eval:fts": "tsx --env-file-if-exists=.env eval/fts-recall.ts",
    "eval:report": "tsx --env-file-if-exists=.env eval/report.ts",
    "eval:import": "tsx --env-file-if-exists=.env scripts/import-eval-results.ts",
    "seed:demo": "tsx --env-file-if-exists=.env scripts/seed-demo.ts",
    "demo:simulate-incident": "tsx --env-file-if-exists=.env scripts/simulate-incident.ts",
    "jev:smoke": "tsx --env-file-if-exists=.env scripts/jev-smoke.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tanstack/react-query": "^5.104.1",
    "@typesafe-ai/sdk": "0.6.0",
    "bullmq": "^6.3.11",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.1",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.1.3"
}
